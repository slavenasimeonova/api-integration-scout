    "name": "IPinfo (API Integration Scout)",
    "description": "IPinfo is a REST API for IP intelligence: geolocation, ASN, anonymity/hosting/mobile flags, and more. It has a free Lite tier and paid Core/Plus/Max tiers, plus a batch endpoint of up to 1,000 lookups per request. The docs cover both a newer api.ipinfo.io schema and a legacy ipinfo.io schema.\n\nGenerated by API Integration Scout from https://ipinfo.io/developers on 2026-10-06T15:06:47.983Z.\nSet {{apiKey}} in the environment. Requests marked Inferred were not explicitly documented; check them before relying on them.\nAuthentication: Bearer token (Authorization header) (documented).\nOther documented auth methods: see the \"Auth alternatives\" folder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "lite",
      "item": [
        {
          "name": "GET /lite/{ip}",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 2xx\", function () {",
                  "  pm.expect(pm.response.code, \"HTTP status\").to.be.within(200, 299);",
                  "});",
                  "var maxResponseMs = Number(pm.variables.get(\"maxResponseMs\")) || 5000;",
                  "pm.test(\"Response time is under \" + maxResponseMs + \" ms\", function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(maxResponseMs);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/lite/:ip",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "lite",
                ":ip"
              ],
              "variable": [
                {
                  "key": "ip",
                  "value": "8.8.8.8",
                  "description": "IPv4, IPv6, or 'me' (example value from the docs)"
                }
              ]
            },
            "description": "Free-tier lookup returning country, continent and ASN. {ip} can be 'me' for the caller's IP. An optional /{field} suffix returns a single field.\n\nStatus: Documented\nSource: https://ipinfo.io/developers"
          }
        }
      ]
    },
