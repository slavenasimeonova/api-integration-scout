# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
SCOUT_MODEL=claude-sonnet-5-5
SCOUT_MAX_PAGES=15
SCOUT_MAX_TOKENS=150000
SCOUT_MAX_BUDGET_USD=0.5

# Request mode (npm run request:list / request:fulfil), see docs/requests.md
# NETLIFY_SITE_ID: Netlify > Project configuration > General > Project ID
# NETLIFY_AUTH_TOKEN: Netlify > User settings > Applications > Personal access tokens
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=

# Push collections into Postman (npm run scout -- ... --postman-push, or npm run postman:push -- <folder>)
# POSTMAN_API_KEY: Postman > avatar > Settings > API keys > Generate API key
# POSTMAN_WORKSPACE_ID: optional; the id in the workspace URL (default: your default workspace)
POSTMAN_API_KEY=
POSTMAN_WORKSPACE_ID=
