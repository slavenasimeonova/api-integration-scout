# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
SCOUT_MODEL=claude-sonnet-5-5
SCOUT_MAX_PAGES=15
SCOUT_MAX_TOKENS=150000
SCOUT_MAX_BUDGET_USD=0.5

# Request mode (npm run request:list / request:fulfil), see docs/requests.md
# NETLIFY_SITE_ID: Netlify > Project configuration > General > Project ID
# NETLIFY_AUTH_TOKEN: Netlify > User settings > Applications > Personal access tokens
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=
